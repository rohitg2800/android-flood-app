# .env.example  —  copy to .env and fill in real values
# NEVER commit .env to version control.

# ── Flood Data API ────────────────────────────────────────────────────
CWC_BASE_URL=https://cwc.gov.in/
FLOOD_API_BASE_URL=https://your-backend.example.com/api

# ── WebSocket ─────────────────────────────────────────────────────────────
WS_URL=wss://your-backend.example.com/ws/gauges

# ── Firebase ─────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── AdMob (optional — leave blank to disable ads) ───────────────────
ADMOB_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
ADMOB_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx

# ── ML Backend (optional — app falls back to linear regression) ──────
# Leave blank to use on-device TFLite model only.
ML_API_URL=https://your-ml-backend.example.com/predict
