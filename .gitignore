# ── ML model artifacts ────────────────────────────────────────────────
# PyTorch model weights & training plots — large binaries, not source code.
# The training_summary.json IS committed (lightweight manifest).
backend/ml/saved_models/*.pt
backend/ml/saved_models/*.png
backend/ml/scalers/*.joblib
# Keep the manifest
!backend/ml/saved_models/training_summary.json

# ── Raw training data ─────────────────────────────────────────────────
data/raw/*.csv

