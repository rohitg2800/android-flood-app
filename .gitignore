# ── Flutter / Dart ────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.g.dart          # generated — but only if not pre-committed
pubspec.lock      # keep for reproducible builds — remove this line if you want

# ── Environment & Secrets ────────────────────────────────────────────
.env
.env.*
!.env.example      # allow the example template

# ── Android signing ───────────────────────────────────────────────────
*.jks
*.keystore
android/key.properties
android/app/google-services.json  # injected by flutterfire configure in CI

# ── Firebase ──────────────────────────────────────────────────────────
lib/firebase_options.dart

# ── Fastlane ──────────────────────────────────────────────────────────
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/.env
fastlane/.env.*

# ── Test artefacts ─────────────────────────────────────────────────────
coverage/
test/golden/failures/       # only failure diffs; committed goldens stay

# ── IDE ────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml

# ── macOS ────────────────────────────────────────────────────────────────
.DS_Store

# ── Misc ────────────────────────────────────────────────────────────────
*.log
*.lock
!pubspec.lock   # re-allow pubspec.lock for reproducibility
